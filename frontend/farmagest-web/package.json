    "test:inventario": "node --test tests/reporte-inventario.test.cjs",
    "test:conteo": "node --test tests/conteo.test.cjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
