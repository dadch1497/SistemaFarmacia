    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "pdfjs-dist": "6.4.299",
    "rxjs": "~7.8.0",
    "tesseract.js": "7.0.0",
    "tslib": "^2.3.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
