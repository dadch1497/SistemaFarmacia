          "name": "Lotes Ordenados por FEFO (Producto #1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Lotes ordenados por vencimiento ascendente\", function () {",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    if (jsonData.length > 1) {",
                  "        var d1 = new Date(jsonData[0].fechaVencimiento);",
                  "        var d2 = new Date(jsonData[1].fechaVencimiento);",
                  "        pm.expect(d1 <= d2).to.be.true;",
                  "    }",
                  "});"
